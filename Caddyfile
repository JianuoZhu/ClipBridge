{
    # The HAProxy tunnel carries TCP only; do not advertise HTTP/3 over UDP.
    servers {
        protocols h1 h2
    }
}

{$CLIP_DOMAIN} {
    @compressible {
        not path_regexp rangedFiles ^/api/(?:items|library)/[0-9a-f-]+/(?:file|preview)$
    }
    encode @compressible zstd gzip
    reverse_proxy clip:8080

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        -Server
    }

    log {
        output stdout
        format console
    }
}
