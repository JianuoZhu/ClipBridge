# Public hostname. Do not include https://
CLIP_DOMAIN=clip.example.com

# PIN for everyday clipboard access (4 to 12 digits).
CLIP_PIN=1223

# Separate admin login for the permanent file library.
CLIP_USERNAME=admin
# Use at least 12 characters. Leave blank to disable admin login and the library.
CLIP_PASSWORD=

# Application behavior
CLIP_RETENTION_HOURS=24
CLIP_MAX_FILE_MB=512
CLIP_MAX_STORAGE_GB=5
CLIP_MAX_TEXT_KB=1024
CLIP_SESSION_DAYS=30
# Must match the home WireGuard address and infra/server/haproxy.cfg.
CLIP_TUNNEL_IP=10.66.0.2

# Optional browser <-> home WebRTC. See docs/p2p.md.
# The compose.p2p.yaml overlay enables this; plain Node needs true here.
CLIP_P2P_ENABLED=false
CLIP_P2P_GATEWAY_URL=http://127.0.0.1:8090
# Generate at least 32 random URL-safe characters; shared only by Node and gateway.
CLIP_P2P_SECRET=
CLIP_P2P_STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302
CLIP_P2P_UDP_PORT=50000
# With Docker bridge networking, optionally advertise the home host's LAN IPv4.
CLIP_P2P_ADVERTISE_IPS=
