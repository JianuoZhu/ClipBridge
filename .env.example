# Public hostname. Do not include https://
CLIP_DOMAIN=clip.jianuo.org

# Login used by every trusted device.
CLIP_USERNAME=admin
# Use a unique password of at least 12 characters.
CLIP_PASSWORD=

# Application behavior
CLIP_RETENTION_HOURS=24
CLIP_MAX_FILE_MB=512
CLIP_MAX_STORAGE_GB=5
CLIP_SESSION_DAYS=30
CLIP_TUNNEL_IP=10.66.0.2
